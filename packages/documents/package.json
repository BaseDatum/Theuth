    "src"
  ],
  "scripts": {
    "bundle": "bun run scripts/build-inproc.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@blocknote/core": "0.54.2",
    "linkedom": "^0.18.15",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": []
}
