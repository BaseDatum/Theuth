{
  "name": "@theuth/documents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "BlockNote documents for theuth: the shared block schema (frontmatter block) and the headless markdown ⇄ blocks ⇄ Yjs helper `t` runs in-process (crates/document-js; design 59 §3.2).",
