{
  "name": "@theuth/apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OpenUI Lang adapter for theuth apps: curated library, generated catalog/hash, headless check/merge validator bundled for t's in-process runtime (design 46; apps-inproc-as-built-P1.md).",
  "exports": {
    ".": "./src/index.ts",
    "./check": "./src/check.ts",
    "./protocol": "./src/protocol.ts",
    "./library": "./src/library.ts",
    "./renderer": "./src/renderer.tsx",
    "./generated/library.json": "./generated/library.json",
    "./generated/catalog.txt": "./generated/catalog.txt"
  },
  "files": [
    "src",
    "generated",
    "patches"
  ],
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "check": "tsc --noEmit",
    "build:inproc": "bun run scripts/build-inproc.ts",
    "record:golden": "bun run scripts/record-inproc-golden.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@openuidev/lang-core": "1.1.1",
    "@openuidev/react-headless": "0.18.10",
    "@openuidev/react-lang": "1.1.1",
    "@openuidev/react-ui": "0.18.10",
    "mermaid": "^12.0.0",
    "react": "19",
    "react-dom": "19",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "26.1.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [],
  "patchedDependencies": {
    "@openuidev/react-lang@1.1.1": "patches/@openuidev%2Freact-lang@1.1.1.patch"
  }
}
