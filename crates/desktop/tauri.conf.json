{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "theuth",
  "version": "2.3.1",
  "mainBinaryName": "theuth-desktop",
  "identifier": "io.theuth.mac",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "dragDropEnabled": false
      },
      {
        "label": "island",
        "title": "",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "width": 440,
        "height": 44
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval' blob: ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* wss: ws:; img-src 'self' asset: http://asset.localhost data: blob: https: http:; frame-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNTk5MEMwMkQ0RjcwRjEKUldUeGNFOHR3SkJaNmxORnpCUHlRUHYwMlV5bHhlUnoxbTQxRmROOWhlbis1ZVlNMTFOakMxU0sK",
      "endpoints": [
        "https://s3.rwx.dev/theuth/releases/latest.json"
      ]
    }
  }
}
