<Project Sdk="Microsoft.NET.Sdk">
  <!-- Port of Tests/TheuthKitTests (design 134 §5.2, §5.3): the contract test over the SAME fixture files the Swift
       companion uses (crates/desktop/companion/Tests/TheuthKitTests/Fixtures — one fixture set, two companions), plus
       RpcClient tests against an in-process Kestrel WebSocket engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Theuth.Companion.Rpc.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Theuth.Companion.Rpc\Theuth.Companion.Rpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\companion\Tests\TheuthKitTests\Fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
