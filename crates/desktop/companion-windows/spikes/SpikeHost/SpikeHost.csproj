<Project Sdk="Microsoft.NET.Sdk">
  <!-- SpikeHost: unpackaged, self-contained WinUI 3 host for the design-134 spikes (S0..S4).
       Build on build-B:  dotnet build -c Debug -p:Platform=x64
       Output:            bin/x64/Debug/net10.0-windows10.0.22621.0/win-x64/SpikeHost.exe -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SpikeHost</RootNamespace>
    <AssemblyName>SpikeHost</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Unpackaged + self-contained: no MSIX, no Windows App Runtime install needed; the runtime is copied beside the exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Windows App SDK line switch (addendum A1):
         default / -p:WasdkLine=1 → 1.8.260317003 (1.8 servicing, March 2026)
         -p:WasdkLine=2            → 2.5.1 (Current channel, latest stable on nuget.org on 2026-10-07)
       Component switch:
         -p:WasdkSplit=true        → reference only the WinUI component package (pulls Base, Foundation,
                                     InteractiveExperiences, WebView2) instead of the meta package, which also drags in
                                     ML (onnxruntime.dll 20.6 MB + DirectML.dll 17.7 MB), AI, Widgets, DWrite, Search. -->
  <PropertyGroup>
    <WasdkLine Condition="'$(WasdkLine)' == ''">1</WasdkLine>
    <WasdkSplit Condition="'$(WasdkSplit)' == ''">false</WasdkSplit>
    <WasdkMetaVersion Condition="'$(WasdkLine)' == '1'">1.8.260317003</WasdkMetaVersion>
    <WasdkMetaVersion Condition="'$(WasdkLine)' == '2'">2.5.1</WasdkMetaVersion>
    <WasdkWinUIVersion Condition="'$(WasdkLine)' == '1'">1.8.260224000</WasdkWinUIVersion>
    <WasdkWinUIVersion Condition="'$(WasdkLine)' == '2'">2.3.9</WasdkWinUIVersion>
    <DefineConstants Condition="'$(WasdkLine)' == '2'">$(DefineConstants);WASDK2</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WasdkSplit)' != 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WasdkMetaVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(WasdkSplit)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WasdkWinUIVersion)" />
  </ItemGroup>
</Project>
