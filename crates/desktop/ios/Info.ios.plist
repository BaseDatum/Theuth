<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSCameraUsageDescription</key>
  <string>theuth scans pairing QR codes to link this phone to your harness.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>theuth records voice notes you send to your harness.</string>
  <!-- Skip the App Store Connect encryption questionnaire on every upload. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- 111: the scene lifecycle, so `ios_windowing.rs` can answer iPadOS 26's windowing-control
       style. tao 0.35 only wires its scene delegate when multiple scenes are declared; extra
       scenes are dismissed in `lib.rs` (the app is one window). -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
    <key>UISceneConfigurations</key>
    <dict/>
  </dict>
</dict>
</plist>
