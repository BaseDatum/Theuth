{
  "$schema": "https://schema.tauri.app/acl/capability/2",
  "identifier": "mobile",
  "description": "The main window on iOS/Android: events, opener, notifications, the QR scanner for /link and the universal-link handoff (31 §8.2), haptics for the voice-note gesture (89).",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "notification:default",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-request-permissions",
    "barcode-scanner:allow-check-permissions",
    "deep-link:default",
    "haptics:default"
  ]
}
