{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@theuth/apps": ["../../../packages/apps/src/index.ts"],
      "@theuth/apps/renderer": ["../../../packages/apps/src/renderer.tsx"],
      "@openuidev/lang-core": ["../../../packages/apps/node_modules/@openuidev/lang-core/dist/index.d.mts"],
      "@openuidev/react-lang": ["../../../packages/apps/node_modules/@openuidev/react-lang/dist/index.d.mts"],
      "@openuidev/react-lang/theuth-runtime": ["../../../packages/apps/node_modules/@openuidev/react-lang/dist/theuth-runtime.d.mts"],
      "@openuidev/react-ui": ["../../../packages/apps/node_modules/@openuidev/react-ui/dist/index.d.mts"],
      "@openuidev/react-ui/genui-lib": ["../../../packages/apps/node_modules/@openuidev/react-ui/dist/genui-lib/index.d.mts"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
