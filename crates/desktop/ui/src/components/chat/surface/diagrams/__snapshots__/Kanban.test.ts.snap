exports[`story map: three labelled bands, the release cut after Should, n/limit headers, state glyphs, unit buttons 1`] = `"<div class="flex flex-col gap-2 overflow-x-auto text-sm"><div class="font-medium">Story map</div><div class="grid gap-x-3 gap-y-2" style="grid-template-columns:repeat(3, minmax(12rem, 1fr))"><div class="rounded-xl bg-layer-2 p-2"><div class="flex items-baseline justify-between px-1"><span class="font-medium">Onboard</span><span class="text-xs text-fg-tertiary tabular-nums" style="color:var(--status-danger-fg)">3/2<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle ml-1 inline size-3 align-[-1px]" aria-label="over limit"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span></div></div><div class="rounded-xl bg-layer-2 p-2"><div class="flex items-baseline justify-between px-1"><span class="font-medium">Chat</span><span class="text-xs text-fg-tertiary tabular-nums" style="color:var(--status-danger-fg)">3/2<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle ml-1 inline size-3 align-[-1px]" aria-label="over limit"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span></div></div><div class="rounded-xl bg-layer-2 p-2"><div class="flex items-baseline justify-between px-1"><span class="font-medium">Boards</span><span class="text-xs text-fg-tertiary tabular-nums">1</span></div></div><div class="text-xs text-fg-secondary" style="grid-column:1 / span 3" data-band="Must">Must</div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"><div data-unit="install" role="button" tabindex="0" aria-label="Install, done" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div class="text-fg-tertiary line-through"><span aria-hidden="true" class="mr-1">✓</span>Install</div></div><div data-unit="login" role="button" tabindex="0" aria-label="Sign in, done" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div class="text-fg-tertiary line-through"><span aria-hidden="true" class="mr-1">✓</span>Sign in</div></div></div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"><div data-unit="ask" role="button" tabindex="0" aria-label="Ask, done" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div class="text-fg-tertiary line-through"><span aria-hidden="true" class="mr-1">✓</span>Ask</div></div></div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"></div><div class="text-xs text-fg-secondary" style="grid-column:1 / span 3" data-band="Should">Should</div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"></div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"><div data-unit="draw" role="button" tabindex="0" aria-label="Draw a chart, blocked" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms;border-color:var(--status-danger-fg)" data-ref="crates/surface/src/render.rs" aria-description="crates/surface/src/render.rs" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div><span aria-hidden="true" class="mr-1" style="color:var(--status-danger-fg)">⊘</span>Draw a chart</div></div></div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"><div data-unit="board" role="button" tabindex="0" aria-label="Open a board" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div>Open a board</div></div></div><div role="separator" aria-label="release cut" data-cut="true" class="border-t-2 border-dashed border-border-strong" style="grid-column:1 / span 3"></div><div class="text-xs text-fg-secondary" style="grid-column:1 / span 3" data-band="Could">Could</div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"><div data-unit="tour" role="button" tabindex="0" aria-label="Tour" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div>Tour</div></div></div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"><div data-unit="export" role="button" tabindex="0" aria-label="Export" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" class="flex flex-col items-start gap-1 rounded-lg border border-border-subtle bg-layer-1 p-2"><div>Export</div></div></div><div class="flex flex-col gap-2 rounded-xl bg-layer-2 p-2"></div></div></div>"`;
