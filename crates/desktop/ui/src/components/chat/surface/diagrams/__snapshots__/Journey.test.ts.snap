exports[`snapshot at the fixed layout 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 268" width="640" height="268" style="max-width:100%;height:auto" role="img" aria-labelledby="m-title m-desc"><title id="m-title">First hour</title><desc id="m-desc">Journey: First hour — 4 stages</desc><text x="12" y="18" font-family="sans-serif" font-size="13" font-weight="600" fill="#111">First hour</text><line x1="12" y1="72" x2="628" y2="72" stroke="#ccc"></line><line x1="12" y1="112" x2="628" y2="112" stroke="#ccc"></line><line x1="12" y1="152" x2="628" y2="152" stroke="#ccc"></line><line x1="100" y1="40" x2="100" y2="208" stroke="#ccc"></line><line x1="232" y1="40" x2="232" y2="208" stroke="#ccc"></line><line x1="364" y1="40" x2="364" y2="208" stroke="#ccc"></line><line x1="496" y1="40" x2="496" y2="208" stroke="#ccc"></line><g><text x="12" y="180" dominant-baseline="central" font-family="ui-monospace, monospace" font-size="11" fill="#666">mood</text><line x1="100" y1="180" x2="628" y2="180" stroke="#ccc" stroke-dasharray="2 4"></line><polyline points="166.0,175.2 298.0,160.8 430.0,158.4 562.0,165.6" fill="none" stroke="#1d5f82" stroke-width="1.5"></polyline><circle cx="166" cy="175.2" r="2" fill="#1d5f82"></circle><circle cx="298" cy="160.8" r="2" fill="#1d5f82"></circle><circle cx="430" cy="158.4" r="2" fill="#1d5f82"></circle><circle cx="562" cy="165.6" r="2" fill="#1d5f82"></circle></g><g><text x="12" y="220" dominant-baseline="central" font-family="ui-monospace, monospace" font-size="11" fill="#666">pains</text><path d="M161 224 L166 216 L171 224 z" fill="#8f2f1f"></path><text x="176" y="220" dominant-baseline="central" font-family="sans-serif" font-size="11" fill="#111">notarisation wait</text></g><g><path d="M557 248 L562 240 L567 248 z" fill="#8f2f1f"></path><text x="572" y="244" dominant-baseline="central" font-family="sans-serif" font-size="11" fill="#111">board takes 40 s</text></g><text x="12" y="92" dominant-baseline="central" font-family="ui-monospace, monospace" font-size="11" fill="#666">Does</text><text x="12" y="132" dominant-baseline="central" font-family="ui-monospace, monospace" font-size="11" fill="#666">Thinks</text><g data-unit="0" role="button" tabindex="0" aria-label="Install, downloads dmg · is it safe?" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" opacity="1"><rect x="100" y="40" width="132" height="216" fill="transparent"></rect><text x="166" y="56" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="13" font-weight="600" fill="#111">Install</text><text x="108" y="92" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">downloads dmg</text><text x="108" y="132" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">is it safe?</text></g><g data-unit="1" role="button" tabindex="0" aria-label="First chat, asks a question · fast enough?" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" opacity="1"><rect x="232" y="40" width="132" height="216" fill="transparent"></rect><text x="298" y="56" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="13" font-weight="600" fill="#111">First chat</text><text x="240" y="92" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">asks a question</text><text x="240" y="132" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">fast enough?</text></g><g data-unit="2" role="button" tabindex="0" aria-label="First diagram, asks for a plan · oh, a chart" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" opacity="1"><rect x="364" y="40" width="132" height="216" fill="transparent"></rect><text x="430" y="56" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="13" font-weight="600" fill="#111">First diagram</text><text x="372" y="92" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">asks for a plan</text><text x="372" y="132" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">oh, a chart</text></g><g data-unit="3" role="button" tabindex="0" aria-label="First board, asks how X works · this is a doc" aria-pressed="false" style="cursor:pointer;transition:opacity 120ms, stroke 120ms, fill 120ms" opacity="1"><rect x="496" y="40" width="132" height="216" fill="transparent"></rect><text x="562" y="56" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="13" font-weight="600" fill="#111">First board</text><text x="504" y="92" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">asks how X works</text><text x="504" y="132" dominant-baseline="central" font-family="sans-serif" font-size="12" fill="#111">this is a doc</text></g></svg>"`;
