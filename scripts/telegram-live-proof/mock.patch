diff --git a/internal/api/ledger.go b/internal/api/ledger.go
new file mode 100644
index 0000000..63df253
--- /dev/null
+++ b/internal/api/ledger.go
@@ -0,0 +1,148 @@
+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+)
+
+// LedgerEntry is one Bot API call as the mock saw it.
+type LedgerEntry struct {
+	Seq      int64           `json:"seq"`
+	At       time.Time       `json:"at"`
+	Method   string          `json:"method"`
+	Params   json.RawMessage `json:"params,omitempty"`
+	Status   int             `json:"status"`
+	Response json.RawMessage `json:"response,omitempty"`
+	TookMS   int64           `json:"took_ms"`
+}
+
+// Ledger is an append-only record of Bot API calls, served by the admin API.
+type Ledger struct {
+	mu      sync.Mutex
+	entries []LedgerEntry
+	next    int64
+}
+
+// ledger is process-wide: the bot server appends, the admin server reads.
+var ledger = &Ledger{next: 1}
+
+// Since returns entries with seq >= since.
+func (l *Ledger) Since(since int64) []LedgerEntry {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	out := make([]LedgerEntry, 0, len(l.entries))
+	for _, e := range l.entries {
+		if e.Seq >= since {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+// Reset drops every entry; seq keeps counting.
+func (l *Ledger) Reset() {
+	l.mu.Lock()
+	l.entries = nil
+	l.mu.Unlock()
+}
+
+func (l *Ledger) add(e LedgerEntry) {
+	l.mu.Lock()
+	e.Seq = l.next
+	l.next++
+	l.entries = append(l.entries, e)
+	l.mu.Unlock()
+}
+
+// recorder captures the status and body written by a handler.
+type recorder struct {
+	http.ResponseWriter
+	status int
+	body   bytes.Buffer
+}
+
+func (r *recorder) WriteHeader(code int) {
+	r.status = code
+	r.ResponseWriter.WriteHeader(code)
+}
+
+func (r *recorder) Write(b []byte) (int, error) {
+	r.body.Write(b)
+	return r.ResponseWriter.Write(b)
+}
+
+// requestParams snapshots the request parameters as JSON (JSON body as-is,
+// form/query values as an object), leaving the body readable for the handler.
+func requestParams(r *http.Request) json.RawMessage {
+	ct := r.Header.Get("Content-Type")
+	if strings.HasPrefix(ct, "application/json") && r.Body != nil {
+		body, err := io.ReadAll(io.LimitReader(r.Body, 10<<20))
+		if err != nil {
+			return nil
+		}
+		r.Body.Close()
+		r.Body = io.NopCloser(bytes.NewReader(body))
+		if json.Valid(body) {
+			return json.RawMessage(body)
+		}
+		b, _ := json.Marshal(string(body))
+		return b
+	}
+	if strings.HasPrefix(ct, "multipart/form-data") {
+		// Text fields only (files are named, not stored); the parsed form stays
+		// on the request for the handler's FormValue calls.
+		if err := r.ParseMultipartForm(32 << 20); err != nil {
+			b, _ := json.Marshal(map[string]string{"multipart_error": err.Error()})
+			return b
+		}
+		m := make(map[string]any, len(r.MultipartForm.Value)+1)
+		for k, v := range r.MultipartForm.Value {
+			if len(v) > 0 {
+				if json.Valid([]byte(v[0])) {
+					m[k] = json.RawMessage(v[0])
+				} else {
+					m[k] = v[0]
+				}
+			}
+		}
+		for k := range r.MultipartForm.File {
+			m[k] = "<file>"
+		}
+		b, _ := json.Marshal(m)
+		return b
+	}
+	_ = r.ParseForm()
+	m := make(map[string]string, len(r.Form))
+	for k, v := range r.Form {
+		if len(v) > 0 {
+			m[k] = v[0]
+		}
+	}
+	b, _ := json.Marshal(m)
+	return b
+}
+
+// recordCall runs handler and appends the call to the ledger.
+func recordCall(method string, w http.ResponseWriter, r *http.Request, handler func(http.ResponseWriter)) {
+	params := requestParams(r)
+	rec := &recorder{ResponseWriter: w, status: http.StatusOK}
+	start := time.Now()
+	handler(rec)
+	var resp json.RawMessage
+	if json.Valid(rec.body.Bytes()) {
+		resp = json.RawMessage(bytes.Clone(rec.body.Bytes()))
+	}
+	ledger.add(LedgerEntry{
+		At:       start,
+		Method:   method,
+		Params:   params,
+		Status:   rec.status,
+		Response: resp,
+		TookMS:   time.Since(start).Milliseconds(),
+	})
+}
