# The one ONNX Runtime pin (57 §6 step 2c): the version every ONNX model in the daemon
# runs on (Parakeet TDT, Nemotron streaming, TEN-VAD, Nemotron diarization, wespeaker, laya), fetched
# from github.com/microsoft/onnxruntime/releases by package-macos.sh (bundled into the .app)
# and release-models.sh (published per platform to the model bucket; the Linux and Windows
# desktop apps download their copy from there, package-linux.sh bundles none). Bumping: change
# ORT_VERSION, refresh every sha256 (`shasum -a 256 onnxruntime-<platform>-<version>.{tgz,zip}`),
# and re-run both scripts. Keep `ort` in Cargo.toml compatible (rc.13 wants ≥ 1.17).
ORT_VERSION="1.32.0"
ORT_SHA256_OSX_ARM64="8ddca23f532b9d4fbb279ba9b08dab6c0ac94fdc9aec2eb44a1db7049216c043"
ORT_DYLIB_SHA256_OSX_ARM64="51c5a25a3dfafd74f62f403e6e0dc7881d97c0e627c703a4d9548c5677abc8fd"   # lib/libonnxruntime.${ORT_VERSION}.dylib inside that archive, as published to the model bucket
ORT_SHA256_LINUX_X64="bb169b7e374731730d2ae406fb39de7be4b315f413a9132efe896261c31bb503"
ORT_SHA256_LINUX_AARCH64="81a46251dd90da4122f4b9ceb4433f836fbc79ee1eddffca7c09033af81a1939"
ORT_SHA256_WIN_X64="aaa1d04fcf86bd31e84b90bc0cbde80e632bd0720dcc5d8ba05c4fe45c09d127"      # onnxruntime-win-x64-${ORT_VERSION}.zip (CPU build; WebGPU comes from the plugin below)
# NuGet Microsoft.ML.OnnxRuntime ${ORT_VERSION} fallback (github.com/microsoft/onnxruntime returns 404 since 2026-11-18)
# and per-arch Windows DLL pins (verified against s3.rwx.dev/theuth/releases/models/models.json and NuGet).
ORT_NUPKG_SHA256="a9150bc2992cbbb6722070da9910e1ffa989a8bfc67bdd5bb8e745ca755641db"
ORT_DLL_SHA256_WIN_X64="348c3d29d6995eee37e3451825eaddb7ea7400be3afda6ca2286b12bc775f042"
ORT_DLL_SHA256_WIN_ARM64="d9db6113549a3bd1eae55dbcb96bd95ee1f35c2823f39a42972664abab6517d2"

# WebGPU plugin execution provider (58 step 13): Microsoft.ML.OnnxRuntime.EP.WebGpu on NuGet
# (the GitHub plugin-ep-webgpu releases carry no assets). Needs ORT ≥ 1.24.4; 0.6.0 is "matched with
# ONNX Runtime 1.32.0" (same contrib-op schemas: bump both together). release-models.sh publishes
# runtimes/<rid>/native/* for win-x64, linux-x64, linux-arm64 under onnxruntime/<triple>/plugins/;
# the Mac runtime has WebGPU built in, so no osx plugin is published.
WEBGPU_EP_VERSION="0.6.0"
WEBGPU_EP_SHA256="ec1123d85edff3dd4aa6ed40adcf55df6d69c60319f4430732d930e3db5f83e7"     # microsoft.ml.onnxruntime.ep.webgpu.${WEBGPU_EP_VERSION}.nupkg
