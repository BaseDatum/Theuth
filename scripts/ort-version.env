# The one ONNX Runtime pin (57 §6 step 2c): the version every ONNX model in the daemon
# runs on (Parakeet TDT, Nemotron streaming, TEN-VAD, Nemotron diarization, wespeaker, laya), fetched
# from github.com/microsoft/onnxruntime/releases by package-macos.sh (bundled into the .app)
# and release-models.sh (published per platform to the model bucket; the Linux and Windows
# desktop apps download their copy from there, package-linux.sh bundles none). Bumping: change
# ORT_VERSION, refresh every sha256 (`shasum -a 256 onnxruntime-<platform>-<version>.{tgz,zip}`),
# and re-run both scripts. Keep `ort` in Cargo.toml compatible (rc.13 wants ≥ 1.17).
ORT_VERSION="1.27.0"
ORT_SHA256_OSX_ARM64="545e81c58152353acb0d1e8bd6ce4b62f830c0961f5b3acfedc790ffd76e477a"
ORT_SHA256_LINUX_X64="547e40a48f1fe73e3f812d7c88a948612c23f896b91e4e2ee1e232d7b468246f"
ORT_SHA256_LINUX_AARCH64="3e4d83ac06924a32a07b6d7f91ce6f852876153fc0bbdf931bf517a140bfbe48"
ORT_SHA256_WIN_X64="c5c81710938e68079ff1a192b04897faabe4b43830d48f39f27ecd4e16138bfc"      # onnxruntime-win-x64-${ORT_VERSION}.zip (CPU build; WebGPU comes from the plugin below)

# WebGPU plugin execution provider (58 step 13): Microsoft.ML.OnnxRuntime.EP.WebGpu on NuGet
# (the GitHub plugin-ep-webgpu releases carry no assets). Needs ORT ≥ 1.24.4. release-models.sh
# publishes runtimes/<rid>/native/* for win-x64, linux-x64, linux-arm64 under
# onnxruntime/<triple>/plugins/; the Mac runtime has WebGPU built in, so no osx plugin is published.
WEBGPU_EP_VERSION="0.4.0"
WEBGPU_EP_SHA256="cc2e093a2eaa760a630d6c3299f015f1dd86885b9eb5877257135308f7c5e923"     # microsoft.ml.onnxruntime.ep.webgpu.${WEBGPU_EP_VERSION}.nupkg
