class Wth < Formula
  desc "Harness that does things for the user"
  homepage "https://github.com/skymoore/wth"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "@BASE_URL@/@VERSION@/wth_@VERSION@_macos-aarch64.tar.gz"
      sha256 "@SHA_MACOS_CLI@"
    end
  end
# @LINUX_BEGIN@
  on_linux do
    on_arm do
      url "@BASE_URL@/@VERSION@/wth_@VERSION@_linux-aarch64.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "@BASE_URL@/@VERSION@/wth_@VERSION@_linux-x86_64.tar.gz"
      sha256 "@SHA_LINUX_X86@"
    end
  end
# @LINUX_END@

  def install
    bin.install "wth"
    # App parser helper (design doc 46 §2.1): `wth` looks for
    # wth-app-parser-<library hash> next to its own resolved path.
    bin.install Dir["wth-app-parser-*"].fetch(0)
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/wth --version")
    helper = Dir[bin/"wth-app-parser-*"].fetch(0)
    assert_match File.basename(helper).delete_prefix("wth-app-parser-"), shell_output("#{helper} --version")
  end
end
