# Local macOS signing + notarization (copy to .env.signing — gitignored).
# Loaded by package-macos / notarize-macos. Already-set env vars win.
#
# One-time notary setup (stores the password in Keychain, not here):
#   xcrun notarytool store-credentials theuth-notary \
#     --apple-id "you@example.com" \
#     --team-id "TEAMID" \
#     --password "app-specific-password-from-appleid.apple.com"
#
# Prefer the SHA-1 hash when `security find-identity -v -p codesigning`
# lists the same Developer ID name twice (codesign rejects ambiguous names).
THEUTH_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
THEUTH_NOTARY_KEYCHAIN_PROFILE="theuth-notary"
THEUTH_NOTARY_TEAM_ID="TEAMID"

# Release bucket (39 §5.4) — rustfs @ s3.rwx.dev, used by release-s3 / stage-linux / test-s3-rustfs.
# The bucket policy (scripts/s3/theuth-bucket-policy.json) makes releases/* public; writes need these keys.
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
THEUTH_S3_ENDPOINT="https://s3.rwx.dev"
THEUTH_S3_BUCKET="theuth"
THEUTH_S3_PREFIX="releases"
# Public download base; default derives from the three above (path-style).
#THEUTH_S3_PUBLIC_BASE_URL="https://s3.rwx.dev/theuth/releases"

# Update signing key (minisign via `cargo tauri signer generate -w ~/.tauri/theuth.key`).
# THEUTH_UPDATE_KEY is the key file path (preferred) or the base64 key contents; the public
# half is committed as crates/update/pubkey.txt and crates/desktop/tauri.conf.json.
THEUTH_UPDATE_KEY="$HOME/.tauri/theuth.key"
THEUTH_UPDATE_KEY_PASSWORD=""

# Homebrew tap bumped by release-s3 (Formula/theuth.rb + Casks/theuth.rb, 39 §3.5).
THEUTH_TAP_REPO="git@github.com:skymoore/homebrew-tap"
# require = abort unless both Linux tarballs are staged; skip = macOS-only release.
THEUTH_RELEASE_LINUX="require"
# Uncomment for an ad-hoc/unnotarized build: writes latest-prerelease.json only, no tap bump.
#THEUTH_RELEASE_PRERELEASE=1
# Uncomment to print uploads/pushes instead of running them.
#THEUTH_S3_DRY_RUN=1
