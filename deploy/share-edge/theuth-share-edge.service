# systemd unit for a plain host (appendix §8.4). Install the binary at /usr/local/bin/theuth-share-edge and the
# config at /etc/theuth-share-edge/config.yaml with `listen: "[::]:443"` and
# `dns.credential_file: /run/credentials/theuth-share-edge.service/dns.json`.
[Unit]
Description=theuth-share-edge (public web sharing edge)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/theuth-share-edge run --config /etc/theuth-share-edge/config.yaml
DynamicUser=yes
StateDirectory=theuth-share-edge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LoadCredential=dns.json:/etc/theuth-share-edge/dns.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
Restart=on-failure

[Install]
WantedBy=multi-user.target
