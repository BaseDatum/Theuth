# Template for /srv/theuth/app/.env. scripts/deploy.sh writes the real file: the non-secret pins below (each
# overridable by the same name in the caller's environment) plus the secrets from the caller's environment.
# For `docker compose config` locally: cp .env.example .env and fill the secrets with dummies.

# Images live in the cluster on 2026-11-26 (tag@digest of the running pods). Both GHCR namespaces are private.
RELAY_IMAGE=ghcr.io/basedatum/theuth/relay:e35c6cc9e@sha256:7e01cee2ab0377bd099172601a848787422a9e8f326a5de73e6c993590c637b3
IROH_RELAY_IMAGE=ghcr.io/basedatum/theuth/iroh-relay:v2.31.2
SHARE_EDGE_IMAGE=ghcr.io/basedatum/theuth/share-edge:v2.31.2
HAPROXY_IMAGE=haproxy:3.2.27-alpine
CADDY_VERSION=2.11.9
CADDY_PORKBUN_VERSION=v0.3.1
ACME_EMAIL=sky@rwx.dev

# --- secrets (deploy.sh fills these from the caller's environment) ---
PORKBUN_TUNZIP_APIKEY=
PORKBUN_TUNZIP_SECRET=
THEUTH_RELAY_COOKIE_SECRET=
